# =============================================================================
# CSOH Security Hardening - .htaccess
# Generated: 2026-02-11
#
# !! INERT. NOTHING IN THIS FILE RUNS IN PRODUCTION. !!
#
# This is a leftover from the original Apache/shared-hosting deployment. The
# site now serves from Cloudflare in front of three origins - S3, Azure Blob
# static websites, and an nginx container on Cloud Run - and *none of them
# reads .htaccess*. The file is not even published: tools/site-publish.filter
# drops every dot-path except /.well-known/, so it never reaches an origin.
#
# It is kept only as a record of intent for rules that still need a real home.
# A rule added here is a rule that does nothing, and the failure is silent -
# no error, no warning, the redirect simply never fires. That is exactly how
# the three retired career-page 301s in section 10 came to 404 in production
# for weeks while this file claimed they were handled, and how Google ended up
# with a pile of "Not found (404)" in Search Console.
#
# Where each concern actually lives now:
#
#   Security headers (section 1) -> infra/terraform/cloudflare/rules.tf
#                                   (cloudflare_ruleset.security_headers),
#                                   infra/terraform/aws/cloudfront.tf, and
#                                   nginx-security-headers.conf. See CLAUDE.md:
#                                   the Cloudflare one carries ignore_changes.
#   Dotfile / sensitive-path deny  -> nginx.conf, plus tools/site-publish.filter
#                                   (which is what keeps them off S3/Azure at all)
#   Redirects (sections 8, 9, 10)  -> infra/terraform/cloudflare/rules.tf
#                                   (cloudflare_ruleset.redirects)
#   Caching (section 6)            -> cloudflare_ruleset.cache in the same file
#   Error pages (section 8)        -> per-origin 404 config
#   WebP negotiation (section 6b)  -> NOT ported. Object-storage origins cannot
#                                   do content negotiation. The <img> tags
#                                   reference .webp directly instead.
#
# BEFORE YOU EDIT: if you want a rule to take effect, put it in the Terraform
# above and apply it. If you only want to record intent, fine - but say so, and
# do not let a runbook cite this file as proof that something is live.
#
# Place this file in the root directory (your document root)
# =============================================================================

# ---------------------------------------------------------------------------
# 1. SECURITY HEADERS
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
    # Force HTTPS for all future visits (1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Block clickjacking - prevent your site from being embedded in iframes
    Header always set X-Frame-Options "DENY"

    # Control referrer information sent to external sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict browser features you don't use
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://csoh.org https://img.youtube.com https://i.ytimg.com https://csoh.goatcounter.com data:; font-src 'self'; connect-src 'self' https://csoh.goatcounter.com; frame-src https://www.youtube.com https://web.archive.org https://docs.google.com https://drive.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

    # Cross-origin isolation: prevent cross-origin windows from holding a
    # reference to ours (defense against cross-origin info leaks / Spectre-
    # class attacks via window.opener and similar). same-origin = only same-
    # origin windows can interact with this one.
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Resources from this origin can only be loaded by same-origin contexts.
    # Stops cross-origin <img>/<script> embedding from arbitrary sites.
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Prevent browsers from caching sensitive pages
    # (Optional: remove if you want caching for performance)
    # Header always set Cache-Control "no-store, no-cache, must-revalidate"

    # Remove server version disclosure
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ---------------------------------------------------------------------------
# 2. SUPPRESS SERVER SIGNATURE
# ---------------------------------------------------------------------------

ServerSignature Off

# ---------------------------------------------------------------------------
# 3. BLOCK ACCESS TO SENSITIVE FILES AND DIRECTORIES
# ---------------------------------------------------------------------------

# Block .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/.*)?$ - [F,L]
    RewriteRule ^\.claude(/.*)?$ - [F,L]
</IfModule>

# Block hidden files and directories (anything starting with .)
#
# NOTE: <FilesMatch> tests the final path component only, so this does NOT block
# /.well-known/security.txt - its basename is "security.txt". That is deliberate
# and load-bearing: /.well-known/security.txt is the RFC 9116 canonical location
# and the URL our own /security.txt names in its `Canonical:` field. If you ever
# "harden" this into a <DirectoryMatch "/\."> or a RewriteRule on the full path,
# add an explicit /.well-known/ carve-out first, or you will silently 403 the
# security contact. nginx.conf hit exactly that bug - see the `location ^~
# /.well-known/` block there.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Python scripts, data files, and internal docs from direct access
<FilesMatch "\.(py|pyc|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# EXCEPTION: Allow specific JSON files that the site JS needs to load
# (preview-mapping.json is loaded by main.js for card previews)
# If main.js fetches these via JS, they need to be accessible.
<Files "preview-mapping.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# EXCEPTION: PWA web app manifest must be publicly fetchable so browsers
# can discover icons + display metadata for "Add to Home Screen".
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# EXCEPTION: meetings.html lazily fetches /meetings-search-index.json so
# users can full-text-search across the FULL recap body (speakers, topics
# buried in the prose), not just the card summaries. Generated by
# tools/build_meetings_search_index.py. Without this exception the JSON
# block above 403s the file and the search input silently does nothing.
<Files "meetings-search-index.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# Block common backup/config files
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block internal report files generated by tooling
<FilesMatch ".*-report\.txt$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# 4. FIX REDIRECT CHAIN (single redirect to canonical URL)
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (if not already handled by hosting provider)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# 5. COMPRESSION (gzip/deflate for smaller transfer sizes)
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
    # Compress text-based content (HTML, CSS, JS, JSON, XML, SVG, fonts)
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-font-opentype

    # Skip already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico|zip|gz|bz2|rar|pdf|woff2)$ no-gzip

    # Inform caches that response varies by Accept-Encoding
    Header append Vary Accept-Encoding
</IfModule>

# ---------------------------------------------------------------------------
# 6. STATIC ASSET CACHING
# ---------------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - short cache, revalidate often
    ExpiresByType text/html "access plus 1 hour"

    # CSS and JS - long cache (use cache-busting filenames when updating)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # XML feeds (RSS, sitemap) - short cache, revalidate often
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"

    # Images - long cache
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# 6b. WEBP CONTENT NEGOTIATION
# ---------------------------------------------------------------------------
#
# When a browser requests foo.jpg AND signals it accepts WebP via the
# Accept header AND a foo.webp file exists alongside, transparently serve
# the .webp instead. Saves ~30-50% bandwidth on the card-heavy pages
# (resources.html, ctfs.html, conferences.html) without requiring any
# HTML changes - the <img src="...jpg"> tags stay as-is.
#
# Generation: tools/generate_webp.py creates the .webp siblings.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only when the browser explicitly accepts WebP (modern browsers do;
    # social-media scrapers often don't, so they keep getting JPEG).
    RewriteCond %{HTTP_ACCEPT} image/webp

    # The original .jpg must exist (so we don't rewrite missing files).
    RewriteCond %{REQUEST_FILENAME} -f

    # Capture the path-without-extension into %1, then check that the
    # .webp sibling exists at that location. Using %N from a RewriteCond
    # regex match is the universally-supported pattern; some Apache 2.4
    # builds don't honor $N backreferences in RewriteCond reliably.
    RewriteCond %{REQUEST_URI} ^(.+)\.jpe?g$
    RewriteCond %{DOCUMENT_ROOT}%1.webp -f

    # Rewrite to /path/foo.webp. T= sets Content-Type so the browser
    # parses it as WebP regardless of the URL still ending in .jpg.
    RewriteRule \.jpe?g$ %1.webp [T=image/webp,L]
</IfModule>

# Tell caches the response can vary by Accept (a Chrome cache shouldn't
# poison a Safari cache with a WebP if Safari didn't ask for it).
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|webp)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 7. DISABLE DIRECTORY LISTING
# ---------------------------------------------------------------------------

Options -Indexes

# ---------------------------------------------------------------------------
# 8. CUSTOM ERROR PAGES (optional - create these files if desired)
# ---------------------------------------------------------------------------

ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

# Redirect old /csoh/ paths to root
RewriteEngine On
RewriteRule ^csoh/(.*)$ /$1 [R=301,L]
RewriteRule ^csoh/?$ / [R=301,L]

# ---------------------------------------------------------------------------
# 9. BARE /index.php -> homepage (legacy front-controller URL) - permanent (301)
# ---------------------------------------------------------------------------
RewriteRule ^index\.php/?$ / [R=301,L]

# ---------------------------------------------------------------------------
# 10. RETIRED CAREER PAGES -> consolidated "Breaking Into Cloud Security" (301)
#     The three entry-path pages (is-it-a-good-career / no-experience /
#     help-desk-to) were merged into breaking-into-cloud-security.html. Keep
#     these 301s so old links, bookmarks, and search results resolve. If you
#     delete the three source files, these rules still work (R=301 fires on the
#     URL match regardless of whether the file exists).
#
#     ^ All true of Apache, and all irrelevant here: these three rules have
#     never fired in production. See the INERT banner at the top of this file.
#     The live versions are cloudflare_ruleset.redirects (ref
#     "retired_career_pages") in infra/terraform/cloudflare/rules.tf.
# ---------------------------------------------------------------------------
RewriteRule ^is-cloud-security-a-good-career\.html$ /breaking-into-cloud-security.html [R=301,L]
RewriteRule ^get-into-cloud-security-no-experience\.html$ /breaking-into-cloud-security.html [R=301,L]
RewriteRule ^help-desk-to-cloud-security\.html$ /breaking-into-cloud-security.html [R=301,L]

# (Removed: meetings.html -> sessions.html redirect.
#  meetings.html is a real page with 91 weekly recap entries - distinct
#  content from sessions.html. The redirect was a stale leftover from
#  before the meetings index was built and was silently consolidating
#  the two pages in search engines. If you re-add a redirect here,
#  remember to also remove meetings.html from sitemap.xml.)